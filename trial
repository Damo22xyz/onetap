            }, fill)

            local knob = new("Frame", {
                Size = UDim2.fromOffset(11, 11),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                BackgroundColor3 = theme.accent,
                BorderSizePixel = 0
            }, bar)

            new("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }, knob)

            local draggingSlider = false

            local function setValue(v)
                local rounded = math.floor(v * multiplier + 0.5) / multiplier
                value = math.clamp(rounded, min, max)

                local alpha = (value - min) / (max - min)

                fill.Size = UDim2.new(alpha, 0, 0, 5)
                fill.Position = UDim2.new(0, 0, 0.5, -2)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value)

                library.Flags[label] = value
                if callback then
                    callback(value)
                end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = true
                    setValue(min + (((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (max - min)))
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setValue(min + (((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (max - min)))
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = false
                end
            end)

            library.Setters[label] = function(valueToSet)
                setValue(valueToSet)
            end

            library.Flags[label] = value
            if callback then
                callback(value)
            end
            registerElement(label, row)
            library.Controls[label] = row
            return row
        end

