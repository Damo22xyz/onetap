                Size = UDim2.new(1, 0, 0, math.min(#options * 30, 180)),
                Position = UDim2.new(0, 0, 1, 5),
                BackgroundColor3 = theme.panel,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 10,
                ClipsDescendants = true,
                CanvasSize = UDim2.fromOffset(0, #options * 30),
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = theme.accent,
                ScrollingDirection = Enum.ScrollingDirection.Y
            }, dropdown)

            new("UICorner", {
                CornerRadius = UDim.new(0, 4)
            }, menu)

            new("UIStroke", {
                Color = theme.border,
                Thickness = 1
            }, menu)

            new("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder
            }, menu)

            local function addOption(option)
                local item = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = theme.panel,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = option,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = theme.text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 11
                }, menu)

                new("UIPadding", {
                    PaddingLeft = UDim.new(0, 8)
                }, item)

                item.MouseEnter:Connect(function()
                    item.BackgroundColor3 = theme.hover
                end)

                item.MouseLeave:Connect(function()
                    item.BackgroundColor3 = theme.panel
                end)

                item.MouseButton1Click:Connect(function()
                    selected = option
                    dropdownText.Text = selected
                    menu.Visible = false
                    library.Flags[label] = selected

                    TweenService:Create(arrow, TweenInfo.new(0.14), {
                        Rotation = 0
                    }):Play()
                    TweenService:Create(dropdown, TweenInfo.new(0.12), {
                        BackgroundColor3 = theme.panel3
                    }):Play()

                    if callback then
                        callback(selected)
                    end
                end)
            end

            local function refreshOptions(newOptions)
                options = newOptions

                for _, child in ipairs(menu:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end

                menu.Size = UDim2.new(1, 0, 0, math.min(#options * 30, 180))
                menu.CanvasSize = UDim2.fromOffset(0, #options * 30)

                for _, option in ipairs(options) do
                    addOption(option)
                end
            end

            library.DropdownRefreshers[label] = refreshOptions
            refreshOptions(options)

            dropdown.MouseEnter:Connect(function()
                TweenService:Create(dropdown, TweenInfo.new(0.12), {
                    BackgroundColor3 = theme.panel3
                }):Play()
            end)

            dropdown.MouseLeave:Connect(function()
                if not menu.Visible then
                    TweenService:Create(dropdown, TweenInfo.new(0.12), {
                        BackgroundColor3 = theme.panel3
                    }):Play()
                end
            end)

            dropdown.MouseButton1Click:Connect(function()
                menu.Visible = not menu.Visible

                if menu.Visible then
                    local menuHeight = menu.AbsoluteSize.Y
                    local bottomEdge = dropdown.AbsolutePosition.Y
                        + dropdown.AbsoluteSize.Y
                        + menuHeight
                        + 5
                    local libraryBottom = main.AbsolutePosition.Y + main.AbsoluteSize.Y

                    menu.Position = bottomEdge > libraryBottom
                        and UDim2.new(0, 0, 0, -menuHeight - 5)
                        or UDim2.new(0, 0, 1, 5)
                end

                TweenService:Create(arrow, TweenInfo.new(0.14), {
                    Rotation = menu.Visible and 180 or 0
                }):Play()
                TweenService:Create(dropdown, TweenInfo.new(0.12), {
                    BackgroundColor3 = theme.panel3
                }):Play()
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if processed then
                    return
                end

                if input.UserInputType == Enum.UserInputType.MouseButton1 and menu.Visible then
                    local mousePos = UserInputService:GetMouseLocation()
                    local menuPos = menu.AbsolutePosition
                    local menuSize = menu.AbsoluteSize
                    local dropdownPos = dropdown.AbsolutePosition
                    local dropdownSize = dropdown.AbsoluteSize

                    local inMenu = mousePos.X >= menuPos.X
                        and mousePos.X <= menuPos.X + menuSize.X
                        and mousePos.Y >= menuPos.Y
                        and mousePos.Y <= menuPos.Y + menuSize.Y

                    local inDropdown = mousePos.X >= dropdownPos.X
                        and mousePos.X <= dropdownPos.X + dropdownSize.X
                        and mousePos.Y >= dropdownPos.Y
                        and mousePos.Y <= dropdownPos.Y + dropdownSize.Y

                    if not inMenu and not inDropdown then
                        menu.Visible = false
                        TweenService:Create(arrow, TweenInfo.new(0.14), {
                            Rotation = 0
                        }):Play()
                        TweenService:Create(dropdown, TweenInfo.new(0.12), {
                            BackgroundColor3 = theme.panel3
                        }):Play()
                    end
                end
            end)

            library.Setters[label] = function(valueToSet)
                for _, option in ipairs(options) do
                    if option == valueToSet then
                        selected = option
                        dropdownText.Text = selected
                        library.Flags[label] = selected

                        if callback then
                            callback(selected)
                        end

                        break
                    end
                end
            end

            library.Flags[label] = selected
            registerElement(label, row)
            library.Controls[label] = row
            return row
        end

        function section:AddColorPicker(label, default, callback)
            local color = default or Color3.fromRGB(255, 255, 255)
            local h, s, v = color:ToHSV()
            local rainbowEnabled = false
            local rainbowConnection

            local row = new("Frame", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1
            }, elements)

            new("TextLabel", {
                Size = UDim2.new(1, -40, 1, 0),
                BackgroundTransparency = 1,
                Text = label,
                Font = Enum.Font.GothamSemibold,
                TextSize = 14,
                TextColor3 = theme.text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center
            }, row)

            local swatch = new("TextButton", {
                Size = UDim2.fromOffset(22, 22),
                Position = UDim2.new(1, -22, 0.5, -11),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Text = "",
                ZIndex = 2
            }, row)

            new("UICorner", { CornerRadius = UDim.new(1, 0) }, swatch)

            new("UIGradient", {
                Rotation = 45,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                })
            }, swatch)

            local swatchRing = new("UIStroke", {
                Color = color,
                Thickness = 2
            }, swatch)

            local popup = new("Frame", {
                Name = "ColorPopup",
                Size = UDim2.fromOffset(190, 150),
                Position = UDim2.new(1, -190, 1, 5),
                BackgroundColor3 = theme.panel,
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 20
            }, row)

            new("UICorner", { CornerRadius = UDim.new(0, 5) }, popup)
            new("UIStroke", { Color = theme.border, Thickness = 1 }, popup)

            local svBox = new("Frame", {
                Size = UDim2.fromOffset(140, 90),
                Position = UDim2.fromOffset(10, 10),
                BackgroundColor3 = Color3.fromHSV(h, 1, 1),
                BorderSizePixel = 0,
                Active = true,
                ZIndex = 21
            }, popup)

            new("UIStroke", { Color = theme.borderSoft, Thickness = 1 }, svBox)

            local svWhite = new("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 22
            }, svBox)
            new("UIGradient", {
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
            }, svWhite)

            local svBlack = new("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 23
            }, svBox)
            new("UIGradient", {
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0)
                })
            }, svBlack)

            local svKnob = new("Frame", {
                Size = UDim2.fromOffset(8, 8),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 24
            }, svBox)
            new("UICorner", { CornerRadius = UDim.new(1, 0) }, svKnob)
            new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, svKnob)

            local hueBar = new("Frame", {
                Size = UDim2.fromOffset(16, 90),
                Position = UDim2.fromOffset(160, 10),
                BorderSizePixel = 0,
                Active = true,
                ZIndex = 21
            }, popup)
            new("UIGradient", {
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                })
            }, hueBar)

            local hueKnob = new("Frame", {
                Size = UDim2.new(1, 4, 0, 3),
                Position = UDim2.new(0, -2, 0, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 24
            }, hueBar)
            new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueKnob)

            local rainbowButton = new("TextButton", {
                Size = UDim2.new(1, -20, 0, 26),
                Position = UDim2.fromOffset(10, 108),
                BackgroundColor3 = theme.panel3,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Text = "Rainbow Mode: Off",
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextColor3 = theme.subtext,
                ZIndex = 21
            }, popup)
            new("UICorner", { CornerRadius = UDim.new(0, 4) }, rainbowButton)
            new("UIStroke", { Color = theme.borderSoft, Thickness = 1 }, rainbowButton)

            local function stopRainbow()
                if rainbowConnection then
                    rainbowConnection:Disconnect()
                    rainbowConnection = nil
                end
            end

            local function updateVisual()
                color = Color3.fromHSV(h, s, v)
                swatchRing.Color = color
                svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
                hueKnob.Position = UDim2.new(0, -2, h, 0)
                library.Flags[label] = color
                library.Flags[label .. " Rainbow"] = rainbowEnabled
                if callback then
                    callback(color)
                end
            end

            local function setRainbow(enabled)
                rainbowEnabled = enabled
                rainbowButton.Text = "Rainbow Mode: " .. (enabled and "On" or "Off")
                rainbowButton.BackgroundColor3 = enabled and theme.accentDark or theme.panel3
                stopRainbow()
                if enabled then
                    rainbowConnection = RunService.Heartbeat:Connect(function(dt)
                        h = (h + dt * 0.15) % 1
                        updateVisual()
                    end)
                end
                library.Flags[label .. " Rainbow"] = rainbowEnabled
            end

            rainbowButton.MouseButton1Click:Connect(function()
                setRainbow(not rainbowEnabled)
            end)

            local draggingSV = false
            local draggingHue = false

            svBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if rainbowEnabled then
                        setRainbow(false)
                    end
                    draggingSV = true
                    local relX = math.clamp((input.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((input.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
                    s, v = relX, 1 - relY
                    updateVisual()
                end
            end)

            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if rainbowEnabled then
                        setRainbow(false)
                    end
                    draggingHue = true
                    local relY = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                    h = relY
                    updateVisual()
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then
                    return
                end
                if draggingSV then
                    local relX = math.clamp((input.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((input.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
                    s, v = relX, 1 - relY
                    updateVisual()
                elseif draggingHue then
                    local relY = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                    h = relY
                    updateVisual()
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = false
                    draggingHue = false
                end
            end)

            swatch.MouseButton1Click:Connect(function()
                popup.Visible = not popup.Visible
                if popup.Visible then
                    local bottomEdge = swatch.AbsolutePosition.Y + swatch.AbsoluteSize.Y + popup.AbsoluteSize.Y + 5
                    local libraryBottom = main.AbsolutePosition.Y + main.AbsoluteSize.Y
                    popup.Position = bottomEdge > libraryBottom
                        and UDim2.new(1, -190, 0, -popup.AbsoluteSize.Y - 5)
                        or UDim2.new(1, -190, 1, 5)
                end
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 or not popup.Visible then
                    return
                end
                local mousePos = UserInputService:GetMouseLocation()
                local popupPos, popupSize = popup.AbsolutePosition, popup.AbsoluteSize
                local swatchPos, swatchSize = swatch.AbsolutePosition, swatch.AbsoluteSize
                local inPopup = mousePos.X >= popupPos.X and mousePos.X <= popupPos.X + popupSize.X
                    and mousePos.Y >= popupPos.Y and mousePos.Y <= popupPos.Y + popupSize.Y
                local inSwatch = mousePos.X >= swatchPos.X and mousePos.X <= swatchPos.X + swatchSize.X
                    and mousePos.Y >= swatchPos.Y and mousePos.Y <= swatchPos.Y + swatchSize.Y
                if not inPopup and not inSwatch then
                    popup.Visible = false
                end
            end)

            library.Setters[label] = function(valueToSet)
                if typeof(valueToSet) == "Color3" then
                    h, s, v = valueToSet:ToHSV()
                    updateVisual()
                end
            end

            library.Setters[label .. " Rainbow"] = function(valueToSet)
                setRainbow(valueToSet == true)
            end

            updateVisual()
            registerElement(label, row)
            library.Controls[label] = row
            return row
        end

        table.insert(tab.Sections, section)
        return section
    end

    library.Tabs[name] = tab
    return tab
end

function library:SetTab(tab)
    for _, other in pairs(library.Tabs) do
        local pageObject = page:FindFirstChild(other.Name .. "Page")
        if pageObject then
            pageObject.Visible = false
        end
        if other.SectionRail then
            other.SectionRail.Visible = false
        end
        if other.IconRail then
            other.IconRail.Visible = false
        end
    end

    for _, child in ipairs(sidebar:GetChildren()) do
        if child:IsA("TextButton") then
            child.BackgroundTransparency = 1
            child.BackgroundColor3 = theme.tabSelected

            local indicator = child:FindFirstChild("Indicator")
            local titleLabel = child:FindFirstChild("Title")
            local tabIcon = child:FindFirstChild("Icon")

            if indicator then
                indicator.Visible = false
            end

            if titleLabel then
                titleLabel.TextColor3 = theme.subtext
            end
            if tabIcon then
                if tabIcon:IsA("TextLabel") then
                    tabIcon.TextColor3 = theme.subtext
                else
                    tabIcon.ImageColor3 = theme.subtext
                end
            end
        end
    end

    local selectedPage = page:FindFirstChild(tab.Name .. "Page")
    if selectedPage then
        selectedPage.Visible = true
    end
    if tab.SectionRail then
        tab.SectionRail.Visible = true
    end
    if tab.IconRail then
        tab.IconRail.Visible = false
    end

    local selectedButton = sidebar:FindFirstChild(tab.Name .. "Tab")
    if selectedButton then
        selectedButton.BackgroundColor3 = theme.tabSelected
        selectedButton.BackgroundTransparency = 0.72

        local indicator = selectedButton:FindFirstChild("Indicator")
        local titleLabel = selectedButton:FindFirstChild("Title")
        local tabIcon = selectedButton:FindFirstChild("Icon")

        if indicator then
            indicator.Visible = true
        end

        if titleLabel then
            titleLabel.TextColor3 = theme.text
        end
        if tabIcon then
            if tabIcon:IsA("TextLabel") then
                tabIcon.TextColor3 = theme.accent
            else
                tabIcon.ImageColor3 = theme.accent
            end
        end
    end

    library.CurrentTab = tab
end

local Players = game:GetService("Players")

return library
