            }, track)

            local fill = new("Frame", {
                Name = "Fill",
                Size = UDim2.new((value - min) / (max - min), 0, 0, 5),
                Position = UDim2.new(0, 0, 0.5, -2),
                BackgroundColor3 = theme.accent,
                BorderSizePixel = 0
            }, bar)

            new("UICorner", {
