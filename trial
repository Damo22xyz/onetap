            }, toggle)

            local function update()
                TweenService:Create(knob, TweenInfo.new(0.12), {
                    BackgroundTransparency = 1
                }):Play()

                TweenService:Create(toggle, TweenInfo.new(0.12), {
                    BackgroundColor3 = value and theme.accent or Color3.fromRGB(43, 42, 49)
                }):Play()
                toggle.UIStroke.Color = value and theme.accent or Color3.fromRGB(92, 90, 100)

                library.Flags[label] = value
                refreshKeybindPanel()
                if callback then
                    callback(value)
                end
            end

            toggle.MouseButton1Click:Connect(function()
                value = not value
                update()
            end)

            keyButton.MouseButton1Click:Connect(function()
                listeningToggle = {
                    label = label,
                    button = keyButton
                }
                keyButton.Text = "..."
            end)

            library.Setters[label] = function(valueToSet)
                value = valueToSet == true
                update()
            end

            registerElement(label, row)
            library.Controls[label] = row
            update()
            return row
