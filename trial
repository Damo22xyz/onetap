local function refreshKeybindPanel()
    for _, child in ipairs(keybindList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local count = 0
    for label, keyCode in pairs(library.Keybinds) do
        count += 1
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 22),
            BackgroundTransparency = 1,
            LayoutOrder = count,
            ZIndex = 51
        }, keybindList)
        new("TextLabel", {
            Size = UDim2.new(1, -88, 1, 0),
            BackgroundTransparency = 1,
            Text = label,
            Font = Enum.Font.GothamSemibold,
            TextSize = 11,
            TextColor3 = theme.subtext,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 52
        }, row)
        new("TextLabel", {
            Size = UDim2.fromOffset(44, 22),
            Position = UDim2.new(1, -86, 0, 0),
            BackgroundTransparency = 1,
            Text = keyCode.Name,
            Font = Enum.Font.GothamSemibold,
            TextSize = 11,
            TextColor3 = theme.text,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 52
        }, row)
        local state = library.Flags[label] == true
        new("TextLabel", {
            Size = UDim2.fromOffset(34, 22),
            Position = UDim2.new(1, -36, 0, 0),
            BackgroundTransparency = 1,
            Text = state and "ON" or "OFF",
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = state and theme.accent or theme.muted,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 52
        }, row)
    end
    keybindPanel.Visible = count > 0
    keybindPanel.Size = UDim2.fromOffset(220, count > 0 and 38 + count * 25 or 36)
end

