local listeningToggle
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if listeningToggle then
        local label = listeningToggle.label
        if input.KeyCode == Enum.KeyCode.Escape then
            listeningToggle.button.Text = library.Keybinds[label] and library.Keybinds[label].Name or "Key"
        elseif input.KeyCode == Enum.KeyCode.Backspace then
            library.Keybinds[label] = nil
            listeningToggle.button.Text = "Key"
        else
            library.Keybinds[label] = input.KeyCode
            listeningToggle.button.Text = input.KeyCode.Name
        end
        listeningToggle = nil
        refreshKeybindPanel()
        return
    end

    for label, keyCode in pairs(library.Keybinds) do
        if keyCode == input.KeyCode and library.Setters[label] then
            library.Setters[label](library.Flags[label] ~= true)
        end
    end
end)

